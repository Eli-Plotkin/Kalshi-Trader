# ─── Shared (kalshi/config.py) ──────────────────────────────────────────
# Kalshi API credentials. Used by every package that places trades.
# Get from https://kalshi.com/account/profile → API Keys → "Create new API key"
API_KEY_ID=
# Absolute path to the matching RSA private key .pem file
PRIVATE_KEY_PATH=

# ─── agent_trader ───────────────────────────────────────────────────────
# Anthropic API key. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Strategy parameters (strategy_config.py) ───────────────────────────
# These define the trading strategy. The repo ships with neutral defaults
# (50-99¢ band, 5% sizing) that don't reflect any specific researched edge.
#
# Use the tools in misprice_discovery/ to find the parameters that work for
# YOUR research, then set them here. Both nba_trading/ (the live bot) and
# misprice_discovery/ (the analysis scripts) read from these env vars.

# Lower bound of the favorite price band, in cents (0-100).
STRATEGY_PRICE_MIN=50

# Upper bound of the favorite price band, in cents (0-100).
STRATEGY_PRICE_MAX=99

# Fraction of EQUITY (cash + open cost) to risk per bet (0-1), also capped by cash and the exposure cap. Full Kelly is usually
# far above this — see misprice_discovery/kelly_simulator.py to calibrate.
# Conservative starting point: 0.05 (5%).
STRATEGY_BANKROLL_FRACTION=0.05

# Cents above the current ask we're willing to pay (slippage tolerance).
# 0 = only fill at the prevailing ask; 1-2 is typical for thin markets.
STRATEGY_LIMIT_BUFFER_CENTS=1

# Halt new bets if equity (cash + open cost) drops this far below its all-time peak (percent).
# Set higher than your expected max drawdown so it only fires on real breaks.
STRATEGY_MAX_DRAWDOWN_PCT=25

# Cap on total open cost across all positions, as % of equity (cash + open
# cost). Stops several same-night games from stacking up.
STRATEGY_MAX_EXPOSURE_PCT=30

# Which Kalshi environment to talk to: prod (real money) or demo.
KALSHI_ENV=prod

# Sport for the misprice_discovery scripts to default to. The live bot in
# nba_trading/ always trades NBA; this only affects analysis tools.
STRATEGY_SPORT=NBA

# ─── Bot state files (optional overrides) ───────────────────────────────
# Defaults are fine; override if you want them in a different location.
# SCHEDULE_FILE=schedule_data.json
# PORTFOLIO_FILE=portfolio_data.json
# HIGH_WATER_FILE=high_water_mark.json
# KILL_SWITCH_FILE=STOP_TRADING   # `touch` this file to stop new orders

# --- Replication: publish the ledger so the separate frontend can read it ---------------------
# TWO private S3-compatible buckets (AWS S3, Cloudflare R2, Backblaze B2, MinIO). R2 has no download fees.
# Why two: providers like R2/B2 scope an API token to a whole BUCKET, not to a key prefix. Keeping the
# data and the control channel in separate buckets lets the frontend's DATA key be strictly READ-ONLY.
#
# 1) DATA bucket: the `replicator` service uploads a consistent snapshot of the ledger here within ~5 s
#    of any change, plus a manifest at least every 10 s. Backend key: read+write+delete. Frontend key:
#    READ-ONLY. It holds your trade history: never public.
REPLICATION_BUCKET=
REPLICATION_PREFIX=kalshi-bot/       # a blank value is treated as this default, never as "no prefix"
REPLICATION_ENDPOINT=                # empty for AWS S3, e.g. https://<account>.r2.cloudflarestorage.com for R2
REPLICATION_REGION=                  # "auto" for R2
REPLICATION_ACCESS_KEY_ID=
REPLICATION_SECRET_ACCESS_KEY=
# REPLICATION_TICK_SECONDS=5          # how often it checks for changes
# REPLICATION_HEARTBEAT_SECONDS=10    # refresh the manifest at least this often even if nothing changed
# REPLICATION_KEEP_SNAPSHOTS=60
# REPLICATION_ALERT_AFTER_SECONDS=120 # alert if no successful publish for this long
#
# 2) CONTROL bucket: the frontend can only REQUEST a pause here (control/pause.json); the bot reads it every
#    30 s, LATCHES it locally, and writes control/ack.json. Resuming is only possible on this server:
#    `docker compose exec bot python -m nba_trading.control resume`. Backend key: read+write+delete.
#    Frontend key: PUT pause.json, GET pause.json and ack.json. Leave CONTROL_BUCKET blank to reuse the
#    data bucket (then the frontend's key needs write access to control/ and you must scope it by prefix).
CONTROL_BUCKET=
# CONTROL_PREFIX=                    # defaults to REPLICATION_PREFIX
# CONTROL_ENDPOINT=                  # defaults to REPLICATION_ENDPOINT, etc.
# CONTROL_REGION=
CONTROL_ACCESS_KEY_ID=
CONTROL_SECRET_ACCESS_KEY=
# CONTROL_POLL_SECONDS=30             # how often the bot checks for a remote pause
# CONTROL_FIRST_READ_TIMEOUT_SECONDS=10  # live mode: wait this long for the first read before scheduling games
