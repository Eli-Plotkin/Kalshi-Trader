# Environment for the FRONTEND (the dashboard) on its own host. Copy to .env.frontend (git-ignored) or set
# these as the platform's secrets. NOTE what is absent: there is NO Kalshi key here, and none is needed.
# See docs/frontend-deployment.md.

DASHBOARD_MODE=remote
# Required in remote mode: the page shows nothing until this is entered. Use a long random value.
DASHBOARD_PASSWORD=
DASHBOARD_SYNC_SECONDS=10
DASHBOARD_DATA_DIR=/tmp/kalshi-dashboard

# 1) The DATA bucket the backend publishes to. Give the frontend its OWN key and make it READ-ONLY
#    (GET only). The frontend never needs to write, overwrite or delete a snapshot.
REPLICATION_BUCKET=
REPLICATION_PREFIX=kalshi-bot/
REPLICATION_ENDPOINT=
REPLICATION_REGION=
REPLICATION_ACCESS_KEY_ID=
REPLICATION_SECRET_ACCESS_KEY=

# 2) The CONTROL bucket (a SEPARATE bucket, so the data key above can stay read-only on providers that
#    scope tokens per bucket). The frontend may PUT control/pause.json and GET pause.json / ack.json.
#    It can only ever request a PAUSE: the bot latches it, and resuming is only possible on the backend
#    server. Leave CONTROL_BUCKET blank to reuse the data bucket (then scope the key by prefix).
CONTROL_BUCKET=
# CONTROL_PREFIX=
# CONTROL_ENDPOINT=
# CONTROL_REGION=
CONTROL_ACCESS_KEY_ID=
CONTROL_SECRET_ACCESS_KEY=
