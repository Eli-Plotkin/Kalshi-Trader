# Secrets and local state must never enter an image. Docker's patterns are anchored at the build
# context root unless they start with `**/`, so each secret pattern is given at any depth.
.env
**/.env
.env.*
**/.env.*
!.env.example
!.env.frontend.example
*.pem
**/*.pem
*.key
**/*.key
secrets/
**/secrets/
data/
**/data/
*.sqlite
**/*.sqlite
*.sqlite-*
**/*.sqlite-*
**/*.sqlite3
**/*.db
**/schedule_data.json
**/portfolio_data.json
**/high_water_mark.json
**/STOP_TRADING
**/trade_bot.log*
**/*.log

# Environments, caches, VCS
venv/
.venv/
env/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.git/
.github/
.claude/
.DS_Store

# Large research artefacts not needed at runtime
*.csv
